# Copy this file to .env and fill in the values. Never commit .env.
# The names match the settings in config. A commented-out line shows the default.

# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and every connection stalls.
# DB_HOST=127.0.0.1

# DB_PORT=5432
# DB_NAME=econ_data
# DB_USER=econ
DB_PASSWORD=
# DB_SECRET_ARN=   # used when DB_PASSWORD is empty: reads the credentials from AWS Secrets Manager

FRED_API_KEY=